<Item class="Script" referent="RBX00001036">
<Properties>
<string name="Name">KSKTycoonServer</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local bindings = require(ReplicatedStorage:WaitForChild("SceneBindings"))
local helpers = bindings.helpers
local states = {}
local recordsBySlot = {}
local entityIds = {"arrival_spawn", "platform_build_pad", "passenger_platform", "station_stairs", "station_build_console", "station_hall", "train_build_pad", "elevated_track", "shuttle_train", "departure_console", "vip_ticket_booth", "vip_entry_gate", "vip_lounge", "plaza_light_west", "plaza_light_east", "concourse_light_a", "concourse_light_b"}
local entityRecords = {}
for _, id in ipairs(entityIds) do
    entityRecords[id] = bindings.get(id)
    if not entityRecords[id] then warn("Missing scene entity binding:", id) end
end
local function findAssembly(container, path)
    if container:GetAttribute("SceneProgramAssembly") == path then return container end
    for _, item in ipairs(container:GetDescendants()) do
        if item:GetAttribute("SceneProgramAssembly") == path then return item end
    end
    return nil
end
local plotSource = findAssembly(workspace, "/plot")
local citySource = findAssembly(workspace, "/city")
if not plotSource or not citySource then error("The authored city plot assemblies are unavailable") end
local plotTemplate = plotSource:Clone()
plotTemplate.Name = "KSKPlotTemplate"
plotTemplate.Parent = ServerStorage
local cityTemplate = citySource:Clone()
cityTemplate.Name = "KSKCityTemplate"
cityTemplate.Parent = ServerStorage
local function isWelcomePart(id)
    return id == "/plot/station/signLeftPost" or id == "/plot/station/signRightPost"
        or string.find(id, "/welcome", 1, true) ~= nil
        or string.find(id, "/made_", 1, true) ~= nil
        or string.find(id, "/ksk_", 1, true) ~= nil
end
local function savePart(part)
    return {CFrame = part.CFrame, Transparency = part.Transparency, CanCollide = part.CanCollide, CanTouch = part.CanTouch, CanQuery = part.CanQuery, Anchored = part.Anchored, Color = part.Color}
end
local function restorePart(part, saved)
    if not part.Parent then return end
    part.CFrame = saved.CFrame
    part.Transparency = saved.Transparency
    part.CanCollide = saved.CanCollide
    part.CanTouch = saved.CanTouch
    part.CanQuery = saved.CanQuery
    part.Anchored = saved.Anchored
    part.Color = saved.Color
end
local function setBoundVisible(record, entityId, visible, keepWelcome)
    for _, part in ipairs(record.partsByEntity[entityId] or {}) do
        local id = part:GetAttribute("SceneProgramPartId")
        if not (keepWelcome and id and isWelcomePart(id)) then
            local saved = record.saved[part]
            if saved then
                if visible then
                    part.Transparency = saved.Transparency
                    part.CanCollide = saved.CanCollide
                    part.CanTouch = saved.CanTouch
                    part.CanQuery = saved.CanQuery
                else
                    part.Transparency = 1
                    part.CanCollide = false
                    part.CanTouch = false
                    part.CanQuery = false
                end
            end
        end
    end
end
local function boundPart(record, entityId, partId)
    for _, sourcePart in ipairs(bindings.parts(entityId)) do
        if sourcePart:IsA("BasePart") and sourcePart:GetAttribute("SceneProgramPartId") == partId then
            local localPart = record.partById[partId]
            if localPart and localPart:IsA("BasePart") then return localPart end
        end
    end
    return nil
end
local function addPointLight(record, entityId, partId, name, color, brightness, range)
    local bulb = boundPart(record, entityId, partId)
    if not bulb then return nil end
    local light = bulb:FindFirstChild(name)
    if not light or not light:IsA("PointLight") then
        light = Instance.new("PointLight")
        light.Name = name
        light.Parent = bulb
    end
    light.Color = color
    light.Brightness = brightness
    light.Range = range
    light.Shadows = true
    record.lights[entityId] = light
    return light
end
local function syncLights(record, state)
    for id, light in pairs(record.lights) do
        if light.Parent then
            if id == "concourse_light_a" or id == "concourse_light_b" then
                light.Enabled = state ~= nil and state.stationBuilt
            else
                light.Enabled = true
            end
        end
    end
end
local function makeRecord(root, city, slot, offset)
    local record = {root = root, city = city, slot = slot, offset = offset, saved = {}, partById = {}, partsByEntity = {}, assemblies = {}, prompts = {}, lights = {}, flashSerial = {}, gateTweens = {}}
    local descendants = root:GetDescendants()
    if root:IsA("BasePart") then table.insert(descendants, root) end
    for _, item in ipairs(descendants) do
        if item:IsA("BasePart") then
            record.saved[item] = savePart(item)
            local partId = item:GetAttribute("SceneProgramPartId")
            if partId then record.partById[partId] = item end
        end
    end
    for _, id in ipairs(entityIds) do
        record.partsByEntity[id] = {}
        for _, sourcePart in ipairs(bindings.parts(id)) do
            if sourcePart:IsA("BasePart") then
                local partId = sourcePart:GetAttribute("SceneProgramPartId")
                local localPart = partId and record.partById[partId]
                if localPart then table.insert(record.partsByEntity[id], localPart) end
            end
        end
    end
    record.trainModel = findAssembly(root, "/plot/train")
    record.trackAssembly = findAssembly(root, "/plot/track")
    record.trackFrame = CFrame.new(offset) * bindings.anchor("elevated_track")
    record.berthFrame = CFrame.lookAt((record.trackFrame * CFrame.new(-25, 0, 0)).Position, (record.trackFrame * CFrame.new(-24, 0, 0)).Position)
    record.endFrame = CFrame.lookAt((record.trackFrame * CFrame.new(30, 0, 0)).Position, (record.trackFrame * CFrame.new(31, 0, 0)).Position)
    setBoundVisible(record, "passenger_platform", false)
    setBoundVisible(record, "station_stairs", false)
    setBoundVisible(record, "station_hall", false, true)
    setBoundVisible(record, "shuttle_train", false)
    setBoundVisible(record, "vip_entry_gate", false)
    setBoundVisible(record, "vip_lounge", false)
    setBoundVisible(record, "concourse_light_a", false)
    setBoundVisible(record, "concourse_light_b", false)
    addPointLight(record, "plaza_light_west", "/plot/lightWest/lightWestBulb", "KSKWarmPool", Color3.fromRGB(255, 228, 188), 1.5, 20)
    addPointLight(record, "plaza_light_east", "/plot/lightEast/lightEastBulb", "KSKWarmPool", Color3.fromRGB(255, 228, 188), 1.5, 20)
    addPointLight(record, "concourse_light_a", "/plot/lightConcourse/lightConcourseDiffuser", "KSKWarmPool", Color3.fromRGB(255, 232, 198), 1.25, 18)
    addPointLight(record, "concourse_light_b", "/plot/lightVip/lightVipDiffuser", "KSKWarmPool", Color3.fromRGB(255, 222, 156), 1.35, 14)
    for _, partId in ipairs({"/plot/padWest/padWestBeacon0", "/plot/padEast/padEastBeacon0"}) do
        local beacon = record.partById[partId]
        if beacon and not beacon:FindFirstChild("KSKBuildGlow") then
            local light = Instance.new("PointLight")
            light.Name = "KSKBuildGlow"
            light.Color = Color3.fromRGB(35, 205, 255)
            light.Brightness = 0.8
            light.Range = 9
            light.Parent = beacon
        end
    end
    return record
end
local function colorPad(record, entityId, color)
    for _, part in ipairs(record.partsByEntity[entityId] or {}) do
        if string.find(part.Name, "Line", 1, true) or string.find(part.Name, "Beacon", 1, true) then
            part.Color = color
        end
    end
end
local function flash(record, part, color)
    if not part or not part.Parent then return end
    local serial = (record.flashSerial[part] or 0) + 1
    record.flashSerial[part] = serial
    local saved = record.saved[part]
    local baseColor = saved and saved.Color or part.Color
    part.Color = color
    task.delay(0.48, function()
        if part.Parent and record.flashSerial[part] == serial then part.Color = baseColor end
    end)
end
local function setPlayerMessage(player, state, message)
    state.status = message
    player:SetAttribute("KSKStatus", message)
end
local actionNames = {build_platform = "Build Platform", build_station = "Build Hall", build_train = "Assemble Train", dispatch_service = "Dispatch", buy_vip_pass = "Buy VIP Pass", enter_vip_lounge = "Open VIP Gate"}
local function eligible(action, state)
    if action == "build_platform" then
        if state.platformBuilt then return false, "Platform already complete" end
        if state.credits < 60 then return false, "Need 60 credits" end
    elseif action == "build_station" then
        if not state.platformBuilt then return false, "Build the platform first" end
        if state.stationBuilt then return false, "Station already complete" end
        if state.credits < 100 then return false, "Need 100 credits" end
    elseif action == "build_train" then
        if not state.stationBuilt then return false, "Build the station first" end
        if state.trainBuilt then return false, "Train already assembled" end
        if state.credits < 100 then return false, "Need 100 credits" end
    elseif action == "dispatch_service" then
        if not state.platformBuilt or not state.stationBuilt or not state.trainBuilt then return false, "Finish all three builds" end
        if state.serviceActive then return false, "Shuttle is out on its route" end
    elseif action == "buy_vip_pass" then
        if not state.stationBuilt then return false, "Open the station first" end
        if state.completedRuns < 1 then return false, "Complete a service first" end
        if state.vipPassOwned then return false, "VIP pass already issued" end
        if state.credits < 75 then return false, "Need 75 credits" end
    elseif action == "enter_vip_lounge" then
        if not state.stationBuilt then return false, "Build the station first" end
        if state.vipGateOpen then return false, "VIP gate is already open" end
        if not state.vipPassOwned then return false, "VIP pass required" end
    end
    return true, "Ready"
end
local function refreshPrompts(record, state)
    for action, controller in pairs(record.prompts) do
        local prompt = controller.prompt
        if prompt and prompt.Parent then
            local ready, why = eligible(action, state)
            prompt.ActionText = ready and (actionNames[action] or "Use") or why
            prompt.ObjectText = action == "buy_vip_pass" and "KSK VIP Booth â€¢ 75 credits" or action == "enter_vip_lounge" and "VIP Waiting Room" or "KSK City Line"
            prompt.Enabled = true
        end
    end
end
local function publish(player, state)
    player:SetAttribute("KSKCredits", state.credits)
    player:SetAttribute("KSKPlatformBuilt", state.platformBuilt)
    player:SetAttribute("KSKStationBuilt", state.stationBuilt)
    player:SetAttribute("KSKTrainBuilt", state.trainBuilt)
    player:SetAttribute("KSKServiceActive", state.serviceActive)
    player:SetAttribute("KSKCompletedRuns", state.completedRuns)
    player:SetAttribute("KSKVipPassOwned", state.vipPassOwned)
    player:SetAttribute("KSKGateOpen", state.vipGateOpen)
    player:SetAttribute("KSKPlotSlot", state.plotSlot)
    player:SetAttribute("KSKStatus", state.status or "Welcome to KSK Games City Line Tycoon")
    if state.plot then
        refreshPrompts(state.plot, state)
        syncLights(state.plot, state)
    end
end
local function lineClear(live, target)
    if not live or not live.root or not target or not target.Parent then return false end
    local origin = live.root.Position + Vector3.new(0, 1.4, 0)
    local delta = target.Position - origin
    if delta.Magnitude > 16 then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {live.character}
    local hit = workspace:Raycast(origin, delta, params)
    return hit == nil or hit.Instance == target
end
local function actionTarget(record, action)
    local mapping = {
        build_platform = {"platform_build_pad", "/plot/padWest/padWestBeacon0"},
        build_station = {"station_build_console", "/plot/stationConsole/stationConsoleScreen"},
        build_train = {"train_build_pad", "/plot/padEast/padEastBeacon0"},
        dispatch_service = {"departure_console", "/plot/departureConsole/departureConsoleScreen"},
        buy_vip_pass = {"vip_ticket_booth", "/plot/vipBooth/boothTicket"},
        enter_vip_lounge = {"vip_entry_gate", "/plot/vipGate/gateLeaf"}
    }
    local entry = mapping[action]
    return entry and boundPart(record, entry[1], entry[2]) or nil
end
local function setStationVisuals(record, visible)
    setBoundVisible(record, "station_hall", visible, false)
    setBoundVisible(record, "vip_lounge", visible)
    setBoundVisible(record, "vip_entry_gate", visible)
    setBoundVisible(record, "concourse_light_a", visible)
    setBoundVisible(record, "concourse_light_b", visible)
end
local function createMover(record)
    if not record.trainModel or not record.trainModel:IsA("Model") then return nil, "Shuttle assembly is unavailable" end
    local berth = record.berthFrame
    for _, item in ipairs(record.trainModel:GetDescendants()) do
        if item:IsA("BasePart") then
            item.Anchored = true
            item.CanCollide = false
            item.CanTouch = false
        end
    end
    local ok, mover = pcall(function()
        return helpers.createGroundMover(record.trainModel, berth, {speed = 10, radius = 1.5, height = 4.5, parent = workspace})
    end)
    if not ok or not mover then return nil, "Shuttle controller could not start" end
    return mover
end
local lifecycleController
local function stopService(player, state, message)
    helpers.clearPlayerCleanup(state, "service")
    state.serviceActive = false
    state.serviceToken = nil
    if state.plot and state.plot.mover then
        local ok, err = pcall(function() state.plot.mover.reset(state.plot.berthFrame) end)
        if not ok then warn("Could not restore shuttle berth:", err) end
    end
    if player and player.Parent == Players then
        if message then setPlayerMessage(player, state, message) end
        publish(player, state)
    end
end
local function release(player, state)
    if state.serviceActive or state.serviceToken then
        stopService(player, state, "Service interrupted. The shuttle is back at its berth; dispatch to retry.")
    else
        helpers.clearPlayerCleanup(state, "service")
    end
end
local function installPrompts(record, state)
    local specs = {
        {"build_platform", "platform_build_pad", "/plot/padWest/padWestBeacon0", "Build", "West Cyan Pad"},
        {"build_station", "station_build_console", "/plot/stationConsole/stationConsoleScreen", "Build", "Station Console"},
        {"build_train", "train_build_pad", "/plot/padEast/padEastBeacon0", "Assemble", "East Cyan Pad"},
        {"dispatch_service", "departure_console", "/plot/departureConsole/departureConsoleScreen", "Dispatch", "Departure Console"},
        {"buy_vip_pass", "vip_ticket_booth", "/plot/vipBooth/boothTicket", "Exchange", "VIP Ticket Booth"},
        {"enter_vip_lounge", "vip_entry_gate", "/plot/vipGate/gateLeaf", "Enter", "VIP Gate"}
    }
    for _, spec in ipairs(specs) do
        local target = boundPart(record, spec[2], spec[3])
        if target then
            local action = spec[1]
            record.prompts[action] = helpers.createInteraction(states, target, {
                ActionText = spec[4], ObjectText = spec[5], HoldDuration = 0,
                MaxActivationDistance = 14, RequiresLineOfSight = false, Enabled = true
            }, function(player, live)
                local current = states[player]
                if not current or current ~= state or record.owner ~= player or current.plot ~= record then return end
                if not live or live.humanoid.Health <= 0 or not live.root.Parent then return end
                local distance = (live.root.Position - target.Position).Magnitude
                if distance > 14 or not lineClear(live, target) then
                    flash(record, target, Color3.fromRGB(255, 58, 65))
                    setPlayerMessage(player, current, "Move closer and clear the approach to use this station fixture.")
                    publish(player, current)
                    return
                end
                local ready, why = eligible(action, current)
                if not ready then
                    flash(record, target, Color3.fromRGB(255, 58, 65))
                    setPlayerMessage(player, current, why .. ". No credits or progress were changed.")
                    publish(player, current)
                    return
                end
                if action == "build_platform" then
                    if not boundPart(record, "passenger_platform", "/plot/platform/boardingDeck") or not boundPart(record, "station_stairs", "/plot/stairs/upperStairLanding") then
                        setPlayerMessage(player, current, "Platform pieces are unavailable; nothing was charged.")
                        publish(player, current)
                        return
                    end
                    current.credits -= 60
                    current.platformBuilt = true
                    colorPad(record, "platform_build_pad", Color3.fromRGB(32, 151, 255))
                    setBoundVisible(record, "passenger_platform", true)
                    setBoundVisible(record, "station_stairs", true)
                    setPlayerMessage(player, current, "Platform and stair route built. Use the central console for the station hall.")
                elseif action == "build_station" then
                    current.credits -= 100
                    current.stationBuilt = true
                    setStationVisuals(record, true)
                    local screen = boundPart(record, "station_build_console", "/plot/stationConsole/stationConsoleScreen")
                    if screen then screen.Color = Color3.fromRGB(53, 225, 151) end
                    setPlayerMessage(player, current, "Station hall open. Assemble the blue shuttle at the east pad.")
                elseif action == "build_train" then
                    if not record.trainModel or not record.trainModel:IsA("Model") then
                        setPlayerMessage(player, current, "Shuttle assembly is unavailable; nothing was charged.")
                        publish(player, current)
                        return
                    end
                    setBoundVisible(record, "shuttle_train", true)
                    local mover, reason = createMover(record)
                    if not mover then
                        setBoundVisible(record, "shuttle_train", false)
                        setPlayerMessage(player, current, reason .. "; nothing was charged.")
                        publish(player, current)
                        return
                    end
                    record.mover = mover
                    current.credits -= 100
                    current.trainBuilt = true
                    colorPad(record, "train_build_pad", Color3.fromRGB(32, 151, 255))
                    local lamp = boundPart(record, "shuttle_train", "/plot/train/frontLampL")
                    if lamp then lamp.Color = Color3.fromRGB(73, 255, 153) end
                    setPlayerMessage(player, current, "Blue shuttle assembled at the berth. Dispatch it from the departure console.")
                elseif action == "dispatch_service" then
                    if not record.mover or record.mover.status == "destroyed" then
                        setPlayerMessage(player, current, "Shuttle controller is unavailable. No service fare was charged.")
                        publish(player, current)
                        return
                    end
                    current.serviceActive = true
                    current.serviceToken = {cancelled = false, done = false, version = current._workVersion}
                    local token = current.serviceToken
                    local departureScreen = target
                    departureScreen.Color = Color3.fromRGB(255, 184, 45)
                    helpers.addPlayerCleanup(current, "service", function()
                        if token.done or token.cancelled then return end
                        token.cancelled = true
                        current.serviceActive = false
                        if current.serviceToken == token then current.serviceToken = nil end
                        if record.mover and record.mover.status ~= "destroyed" then
                            local ok, err = pcall(function() record.mover.reset(record.berthFrame) end)
                            if not ok then warn("Could not return interrupted shuttle:", err) end
                        end
                        if player.Parent == Players then
                            setPlayerMessage(player, current, "Service interrupted. The shuttle is back at its berth; dispatch to retry.")
                            publish(player, current)
                        end
                    end)
                    setPlayerMessage(player, current, "Shuttle dispatched. Fare is awarded only after a verified return to the berth.")
                    publish(player, current)
                    task.spawn(function()
                        local function stillCurrent()
                            return not token.cancelled and not token.done and current.serviceToken == token
                                and current.serviceActive and current._workVersion == token.version
                                and current.plot == record and record.owner == player and record.mover ~= nil
                        end
                        local function travelTo(destination)
                            if not stillCurrent() or record.mover.status == "destroyed" then return false, "cancelled" end
                            record.mover.setTarget(destination, {arrivalDistance = 1.2})
                            local deadline = os.clock() + 8
                            while os.clock() < deadline do
                                if not stillCurrent() or not record.trainModel.Parent or record.mover.status == "destroyed" then return false, "cancelled" end
                                local status = record.mover.status
                                if status == "unreachable" then return false, "The shuttle route is blocked; service fare not earned." end
                                if status == "arrived" then
                                    local actual = record.mover.position()
                                    if math.abs(actual.X - destination.X) <= 3 and math.abs(actual.Z - destination.Z) <= 3 then return true end
                                end
                                task.wait(0.08)
                            end
                            return false, "The shuttle could not complete its route; service fare not earned."
                        end
                        local outward, why = travelTo(record.endFrame.Position)
                        if not outward then
                            if why ~= "cancelled" and lifecycleController and states[player] == current then
                                lifecycleController.reset(player, function(p, sameState)
                                    sameState.serviceActive = false
                                    sameState.serviceToken = nil
                                    setPlayerMessage(p, sameState, why .. " Dispatch again to retry.")
                                    publish(p, sameState)
                                end)
                            end
                            return
                        end
                        if not stillCurrent() then return end
                        task.wait(0.45)
                        if not stillCurrent() then return end
                        local returning, returnWhy = travelTo(record.berthFrame.Position)
                        if not returning then
                            if returnWhy ~= "cancelled" and lifecycleController and states[player] == current then
                                lifecycleController.reset(player, function(p, sameState)
                                    sameState.serviceActive = false
                                    sameState.serviceToken = nil
                                    setPlayerMessage(p, sameState, returnWhy .. " Dispatch again to retry.")
                                    publish(p, sameState)
                                end)
                            end
                            return
                        end
                        if not stillCurrent() or token.done then return end
                        token.done = true
                        current.serviceActive = false
                        current.serviceToken = nil
                        current.completedRuns += 1
                        current.credits += 50 + (current.vipPassOwned and 25 or 0)
                        departureScreen.Color = Color3.fromRGB(73, 255, 153)
                        setPlayerMessage(player, current, current.vipPassOwned and "Verified arrival! +75 credits, including your VIP fare bonus." or "Verified arrival! +50 credits. Use the booth after your first service to earn VIP access.")
                        helpers.clearPlayerCleanup(current, "service")
                        publish(player, current)
                    end)
                elseif action == "buy_vip_pass" then
                    current.credits -= 75
                    current.vipPassOwned = true
                    local ticket = target
                    ticket.Color = Color3.fromRGB(255, 198, 42)
                    local lamp = boundPart(record, "vip_entry_gate", "/plot/vipGate/gateLamp")
                    if lamp then lamp.Color = Color3.fromRGB(255, 201, 57) end
                    setPlayerMessage(player, current, "VIP pass issued for 75 credits. Your next completed service earns a 25-credit bonus.")
                elseif action == "enter_vip_lounge" then
                    local leaf = boundPart(record, "vip_entry_gate", "/plot/vipGate/gateLeaf")
                    local goldBar = boundPart(record, "vip_entry_gate", "/plot/vipGate/gateGoldBar")
                    if not leaf or not goldBar then
                        setPlayerMessage(player, current, "The VIP gate is unavailable; your pass is unchanged.")
                        publish(player, current)
                        return
                    end
                    current.vipGateOpen = true
                    local closed = leaf.CFrame
                    local hinge = closed.Position + Vector3.new(0, 0, -leaf.Size.Z * 0.5)
                    local swing = CFrame.new(hinge) * CFrame.Angles(0, math.rad(90), 0) * CFrame.new(-hinge)
                    local openLeaf = swing * closed
                    local barOffset = closed:ToObjectSpace(goldBar.CFrame)
                    for _, tween in ipairs(record.gateTweens) do tween:Cancel() end
                    record.gateTweens = {}
                    local info = TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                    local leafTween = TweenService:Create(leaf, info, {CFrame = openLeaf})
                    local barTween = TweenService:Create(goldBar, info, {CFrame = openLeaf * barOffset})
                    record.gateTweens = {leafTween, barTween}
                    leafTween:Play()
                    barTween:Play()
                    local lamp = boundPart(record, "vip_entry_gate", "/plot/vipGate/gateLamp")
                    if lamp then lamp.Color = Color3.fromRGB(79, 255, 166) end
                    setPlayerMessage(player, current, "VIP gate open. Walk through to the waiting room.")
                end
                publish(player, current)
            end)
        else
            warn("No bound target for interaction:", spec[1], spec[3])
        end
    end
    refreshPrompts(record, state)
end
local function shiftParts(root, offset)
    if offset.Magnitude == 0 then return end
    local items = root:GetDescendants()
    if root:IsA("BasePart") then table.insert(items, root) end
    local transform = CFrame.new(offset)
    for _, item in ipairs(items) do
        if item:IsA("BasePart") then item.CFrame = transform * item.CFrame end
    end
end
local function lowestFreeSlot()
    local slot = 0
    while recordsBySlot[slot] do slot += 1 end
    return slot
end
local function createPlot(state)
    local slot = lowestFreeSlot()
    local offset = Vector3.new(slot * 110, 0, 0)
    local root, city
    if slot == 0 then
        root, city = plotSource, citySource
    else
        root = plotTemplate:Clone()
        city = cityTemplate:Clone()
        root.Name = "KSKPlot_" .. tostring(slot)
        city.Name = "KSKCity_" .. tostring(slot)
        shiftParts(root, offset)
        shiftParts(city, offset)
        root.Parent = workspace
        city.Parent = workspace
    end
    local record = makeRecord(root, city, slot, offset)
    record.owner = state.player
    record.state = state
    state.plotSlot = slot
    state.plot = record
    recordsBySlot[slot] = record
    installPrompts(record, state)
    return record
end
local function makeState(player)
    local state = {
        player = player, credits = 320, platformBuilt = false, stationBuilt = false,
        trainBuilt = false, serviceActive = false, completedRuns = 0,
        vipPassOwned = false, vipGateOpen = false, status = "Welcome to KSK Games City Line Tycoon"
    }
    createPlot(state)
    publish(player, state)
    return state
end
local function arrivalFloor(state)
    local authored = CFrame.new(state.plot.offset) * bindings.anchor("arrival_spawn")
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {state.plot.root, state.plot.city}
    local start = authored.Position + Vector3.new(0, 8, 0)
    local hit = workspace:Raycast(start, Vector3.new(0, -24, 0), params)
    if not hit or not hit.Instance:IsA("BasePart") or not hit.Instance.CanCollide then return nil end
    local facing = authored.LookVector
    return CFrame.lookAt(hit.Position, hit.Position + Vector3.new(facing.X, 0, facing.Z), Vector3.yAxis)
end
local function restoreCharacter(player, state, character, humanoid, root)
    if state.plot then publish(player, state) end
    if player.Character ~= character or not root.Parent or humanoid.Health <= 0 then return end
    local floorFrame = arrivalFloor(state)
    if floorFrame and helpers.placePlayer(states, player, floorFrame) then return end
    local version = state._workVersion
    task.spawn(function()
        for _ = 1, 6 do
            task.wait(0.2)
            if player.Parent ~= Players or player.Character ~= character or state._workVersion ~= version then return end
            local live = helpers.getLivePlayer(states, player)
            if not live or live.character ~= character or live.humanoid.Health <= 0 or not live.root.Parent then return end
            local retryFrame = arrivalFloor(state)
            if retryFrame and helpers.placePlayer(states, player, retryFrame) then return end
        end
        if player.Parent == Players and player.Character == character then
            setPlayerMessage(player, state, "Arrival is blocked. Move to the south forecourt; your plot progress is safe.")
            publish(player, state)
        end
    end)
end
lifecycleController = helpers.bindPlayerLifecycle(Players, states, makeState, restoreCharacter, release)
local function resetRecord(record)
    if record.mover then
        local mover = record.mover
        if mover.status ~= "destroyed" then
            local ok, err = pcall(function() mover.reset(record.berthFrame) end)
            if not ok then warn("Could not restore shuttle before plot release:", err) end
        end
        mover.destroy()
        record.mover = nil
    end
    for _, controller in pairs(record.prompts) do controller.destroy() end
    record.prompts = {}
    for _, tween in ipairs(record.gateTweens) do tween:Cancel() end
    record.gateTweens = {}
    for part, saved in pairs(record.saved) do restorePart(part, saved) end
    for _, id in ipairs({"passenger_platform", "station_stairs", "shuttle_train", "vip_entry_gate", "vip_lounge", "concourse_light_a", "concourse_light_b"}) do
        setBoundVisible(record, id, false)
    end
    setBoundVisible(record, "station_hall", false, true)
    colorPad(record, "platform_build_pad", Color3.fromRGB(13, 209, 255))
    colorPad(record, "train_build_pad", Color3.fromRGB(13, 209, 255))
    for id, light in pairs(record.lights) do
        if light.Parent then light.Enabled = id == "plaza_light_west" or id == "plaza_light_east" end
    end
end
Players.PlayerRemoving:Connect(function(player)
    for slot, record in pairs(recordsBySlot) do
        if record.owner == player then
            if record.state then release(player, record.state) end
            resetRecord(record)
            record.owner = nil
            record.state = nil
            recordsBySlot[slot] = nil
            if slot ~= 0 then
                record.root:Destroy()
                if record.city then record.city:Destroy() end
            end
            break
        end
    end
    states[player] = nil
end)
RunService.Heartbeat:Connect(function(dt)
    for _, record in pairs(recordsBySlot) do
        local state = record.state
        if record.mover and state and state.serviceActive and record.mover.status ~= "destroyed" then
            record.mover.step(dt)
        end
    end
end)
game:BindToClose(function()
    lifecycleController.destroy()
    for _, record in pairs(recordsBySlot) do resetRecord(record) end
end)
]]></ProtectedString>
