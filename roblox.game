<ProtectedString name="Source"><![CDATA[local registry = game:GetService("HttpService"):JSONDecode([=[{"arrival_spawn":{"id":"arrival_spawn","role":"spawn_anchor","worldAnchor":[0,3,30,1,0,0,0,1,0,0,0,1],"partIds":[]},"platform_build_pad":{"id":"platform_build_pad","role":"build_pad","worldAnchor":[-20,0,14,1,0,0,0,1,0,0,0,1],"partIds":["/plot/padWest/padWestLineN","/plot/padWest/padWestLineS","/plot/padWest/padWestLineW","/plot/padWest/padWestLineE","/plot/padWest/padWestBeacon0","/plot/padWest/padWestBeacon1","/plot/padWest/padWestBeacon2","/plot/padWest/padWestBeacon3"]},"passenger_platform":{"id":"passenger_platform","role":"boarding_platform","worldAnchor":[5,8.5,-21.5,1,0,0,0,1,0,0,0,1],"partIds":["/plot/platform/boardingDeck","/plot/platform/platformBlueEdge","/plot/platform/platformPier-0.4_-23.4","/plot/platform/platformPier-0.4_-19.6","/plot/platform/platformPier10.4_-23.4","/plot/platform/platformPier10.4_-19.6","/plot/platform/platformCrossbeam","/plot/platform/platformSideRail-0.8","/plot/platform/platformSidePost-0.8_0","/plot/platform/platformSidePost-0.8_1","/plot/platform/platformSidePost-0.8_2","/plot/platform/platformSidePost-0.8_3","/plot/platform/platformSideRail10.8","/plot/platform/platformSidePost10.8_0","/plot/platform/platformSidePost10.8_1","/plot/platform/platformSidePost10.8_2","/plot/platform/platformSidePost10.8_3","/plot/platform/trainSeparationRail","/plot/platform/trainSeparationPost0","/plot/platform/trainSeparationPost1","/plot/platform/trainSeparationPost2","/plot/platform/trainSeparationPost3","/plot/platform/trainSeparationPost4","/plot/platform/trainSeparationPost5","/plot/platform/trainSeparationPost6"]},"station_stairs":{"id":"station_stairs","role":"access_stairs","worldAnchor":[2.5,0,-15,1,0,0,0,1,0,0,0,1],"partIds":["/plot/stairs/lowerFlight/flight/@tread-1","/plot/stairs/lowerFlight/flight/@tread-2","/plot/stairs/lowerFlight/flight/@tread-3","/plot/stairs/lowerFlight/flight/@tread-4","/plot/stairs/lowerFlight/flight/@tre