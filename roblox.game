<Item class="LocalScript" referent="RBX00001037">
<Properties>
<string name="Name">KSKTycoonClient</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
while not camera do
    Workspace:GetPropertyChangedSignal("CurrentCamera"):Wait()
    camera = Workspace.CurrentCamera
end
local gui = Instance.new("ScreenGui")
gui.Name = "KSKCityLineHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.DisplayOrder = 20
gui.Parent = player:WaitForChild("PlayerGui")
local panel = Instance.new("Frame")
panel.Name = "TycoonPanel"
panel.Position = UDim2.fromOffset(14, 46)
panel.BackgroundColor3 = Color3.fromRGB(12, 24, 38)
panel.BackgroundTransparency = 0.12
panel.BorderSizePixel = 0
panel.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = panel
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(36, 195, 235)
stroke.Transparency = 0.2
stroke.Thickness = 1.5
stroke.Parent = panel
local padding = Instance.new("UIPadding")
padding.PaddingLeft = UDim.new(0, 14)
padding.PaddingRight = UDim.new(0, 14)
padding.PaddingTop = UDim.new(0, 12)
padding.PaddingBottom = UDim.new(0, 10)
padding.Parent = panel
local function makeLabel(name, size, y, height, color, font)
    local label = Instance.new("TextLabel")
    label.Name = name
    label.BackgroundTransparency = 1
    label.Position = UDim2.fromOffset(0, y)
    label.Size = UDim2.new(1, 0, 0, height)
    label.Font = font or Enum.Font.Gotham
    label.TextColor3 = color
    label.TextSize = size
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.TextWrapped = true
    label.Parent = panel
    return label
end
local title = makeLabel("Welcome", 15, 0, 25, Color3.fromRGB(107, 225, 255), Enum.Font.GothamBold)
title.Text = "WELCOME  â€¢  MADE BY KSK GAMES"
local subtitle = makeLabel("GameTitle", 13, 25, 21, Color3.fromRGB(230, 240, 248), Enum.Font.GothamSemibold)
subtitle.Text = "CITY LINE TYCOON"
local credits = makeLabel("Credits", 22, 49, 31, Color3.fromRGB(255, 207, 79), Enum.Font.GothamBold)
local progress = makeLabel("Progress", 13, 84, 91, Color3.fromRGB(226, 238, 247), Enum.Font.GothamMedium)
progress.TextYAlignment = Enum.TextYAlignment.Top
local status = makeLabel("Status", 12, 177, 38, Color3.fromRGB(115, 228, 190), Enum.Font.GothamSemibold)
status.TextYAlignment = Enum.TextYAlignment.Top
local footer = makeLabel("Hint", 11, 216, 22, Color3.fromRGB(156, 182, 199), Enum.Font.Gotham)
footer.Text = "Walk to the glowing pads and use the nearby prompt."
local function fitPanel()
    local width = math.max(260, math.min(350, camera.ViewportSize.X - 28))
    panel.Size = UDim2.fromOffset(width, 250)
end
fitPanel()
camera:GetPropertyChangedSignal("ViewportSize"):Connect(fitPanel)
local function flag(attribute)
    return player:GetAttribute(attribute) == true
end
local function refresh()
    local money = player:GetAttribute("KSKCredits")
    credits.Text = "CREDITS  " .. tostring(money or 320)
    local platform = flag("KSKPlatformBuilt")
    local station = flag("KSKStationBuilt")
    local train = flag("KSKTrainBuilt")
    local runs = player:GetAttribute("KSKCompletedRuns") or 0
    local pass = flag("KSKVipPassOwned")
    local gate = flag("KSKGateOpen")
    local function line(done, text, nextText)
        if done then return "BUILT   " .. text end
        return "NEXT    " .. nextText
    end
    progress.Text = line(platform, "Passenger platform + stairs", "Platform â€¢ 60 credits") .. "\n"
        .. line(station, "Station hall + VIP room", "Station hall â€¢ 100 credits") .. "\n"
        .. line(train, "Blue shuttle assembled", "Shuttle â€¢ 100 credits") .. "\n"
        .. "SERVICE   " .. tostring(runs) .. " completed   â€¢   " .. (flag("KSKServiceActive") and "IN ROUTE" or "READY") .. "\n"
        .. "VIP PASS   " .. (pass and "ISSUED" or (runs > 0 and "75 credits at the booth" or "After your first service")) .. "\n"
        .. "VIP GATE   " .. (gate and "OPEN" or "" .. (pass and "Ready" or "Locked"))
    status.Text = player:GetAttribute("KSKStatus") or "Build the west platform to begin."
end
for _, attribute in ipairs({"KSKCredits", "KSKPlatformBuilt", "KSKStationBuilt", "KSKTrainBuilt", "KSKServiceActive", "KSKCompletedRuns", "KSKVipPassOwned", "KSKGateOpen", "KSKStatus"}) do
    player:GetAttributeChangedSignal(attribute):Connect(refresh)
end
refresh()
local activeCharacter
local cameraPosition
RunService.RenderStepped:Connect(function(dt)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return end
    camera.CameraType = Enum.CameraType.Scriptable
    local focus = root.Position + Vector3.new(0, 2.5, 0)
    local desired = focus + Vector3.new(0, 19, 30)
    if character ~= activeCharacter or not cameraPosition then
        activeCharacter = character
        cameraPosition = desired
    else
        cameraPosition = cameraPosition:Lerp(desired, math.min(dt * 5, 1))
    end
    camera.CFrame = CFrame.lookAt(cameraPosition, focus)
    camera.Focus = CFrame.new(focus)
end)
]]></ProtectedString>
