Console/departureConsolePadN","/plot/departureConsole/departureConsolePadS","/plot/departureConsole/departureConsolePadW","/plot/departureConsole/departureConsolePadE"]},"vip_ticket_booth":{"id":"vip_ticket_booth","role":"ticket_booth","worldAnchor":[-35,0,4,1,0,0,0,1,0,0,0,1],"partIds":["/plot/vipBooth/boothBase","/plot/vipBooth/boothBack","/plot/vipBooth/boothSideA","/plot/vipBooth/boothSideB","/plot/vipBooth/boothRoof","/plot/vipBooth/boothCounter","/plot/vipBooth/boothCounterTop","/plot/vipBooth/boothSign","/plot/vipBooth/boothTicket","/plot/vipBooth/boothStripe"]},"vip_entry_gate":{"id":"vip_entry_gate","role":"vip_gate","worldAnchor":[-22.5,0,-13.5,6.123233995736766e-17,0,1,0,1,0,-1,0,6.123233995736766e-17],"partIds":["/plot/vipGate/gateJambA","/plot/vipGate/gateJambB","/plot/vipGate/gateHeader","/plot/vipGate/gateLeaf","/plot/vipGate/gateGoldBar","/plot/vipGate/gateLamp"]},"vip_lounge":{"id":"vip_lounge","role":"waiting_room","worldAnchor":[-26,0,-13,1,0,0,0,1,0,0,0,1],"partIds":["/plot/vipLounge/loungeWest/@solid-0-0","/plot/vipLounge/loungeRear/@solid-0-0","/plot/vipLounge/loungeSouth/@solid-0-0","/plot/vipLounge/loungePartition/@solid-0-0","/plot/vipLounge/loungePartition/@solid-0-1","/plot/vipLounge/loungePartition/@solid-1-1","/plot/vipLounge/loungePartition/@solid-2-0","/plot/vipLounge/loungePartition/@solid-2-1","/plot/vipLounge/loungeGoldBand","/plot/vipLounge/loungeBenchSeat","/plot/vipLounge/loungeBenchBack","/plot/vipLounge/loungeBenchLeg-14.3","/plot/vipLounge/loungeBenchLeg-11.7","/plot/vipLounge/loungeTrim"]},"plaza_light_west":{"id":"plaza_light_west","role":"light_fixture","worldAnchor":[-33.1,6,10,1,0,0,0,1,0,0,0,1],"partIds":["/plot/lightWest/lightWestPole","/plot/lightWest/lightWestArm","/plot/lightWest/lightWestLampHousing","/plot/lightWest/lightWestBulb","/plot/lightWest/lightWestBase"]},"plaza_light_east":{"id":"plaza_light_east","role":"light_fixture","worldAnchor":[31.9,6,9,1,0,0,0,1,0,0,0,1],"partIds":["/plot/lightEast/lightEastPole","/plot/lightEast/lightEastArm","/plot/lightEast/lightEastLampHousing","/plot/lightEast/lightEastBulb","/plot/lightEast/lightEastBase"]},"concourse_light_a":{"id":"concourse_light_a","role":"light_fixture","worldAnchor":[-14,9,-8,1,0,0,0,1,0,0,0,1],"partIds":["/plot/lightConcourse/lightConcourseMount","/plot/lightConcourse/lightConcourseShade","/plot/lightConcourse/lightConcourseDiffuser"]},"concourse_light_b":{"id":"concourse_light_b","role":"light_fixture","worldAnchor":[-26.5,9,-13,1,0,0,0,1,0,0,0,1],"partIds":["/plot/lightVip/lightVipMount","/plot/lightVip/lightVipShade","/plot/lightVip/lightVipDiffuser"]}}]=])
local spawns = game:GetService("HttpService"):JSONDecode([=[{"arrival_spawn":"scene-spawn:arrival_spawn"}]=])
local api = {}
function api.get(id) local entry=registry[id]; assert(entry, "Unknown scene entity"); return entry end
function api.anchor(id) return CFrame.new(table.unpack(api.get(id).worldAnchor)) end
function api.parts(id)
 local wanted={}; for _,partId in ipairs(api.get(id).partIds) do wanted[partId]=true end
 local found={}; for _,object in ipairs(workspace:GetDescendants()) do
  if object:IsA("BasePart") and wanted[object:GetAttribute("SceneProgramPartId")] then table.insert(found,object) end
 end
 return found
end
-- The engine owns player placement: this SpawnLocation is emitted for the declared spawn entity.
function api.spawn(id)
 local wanted=spawns[id]; if not wanted then return nil end
 for _,object in ipairs(workspace:GetDescendants()) do
  if object:IsA("SpawnLocation") and object:GetAttribute("SceneProgramPartId")==wanted then return object end
 end
 return nil
end
do
local function getLivePlayer(states, player)
  local data, character = states[player], player.Character
  local humanoid = character and character:FindFirstChildOfClass("Humanoid")
  local root = character and character:FindFirstChild("HumanoidRootPart")
  if not data or not player.Parent or not character or not character.Parent
    or not humanoid or humanoid.Health <= 0 or not root then return nil end
  return data, character, humanoid, root
end

local function invalidatePlayerWork(data)
  data._workVersion = (data._workVersion or 0) + 1
  for _, connection in ipairs(data._transientConnections or {}) do connection:Disconnect() end
  data._transientConnections = {}
  return data._workVersion
end

local function restoreCurrentCharacter(states, player, character, version, restore)
  local data = states[player]
  if not data or not character then return false end
  while not character.Parent do
    if states[player] ~= data or data._workVersion ~= version or not player.Parent
      or player.Character ~= character then return false end
    task.wait()
  end
  local humanoid = character:WaitForChild("Humanoid", 10)
  local root = character:WaitForChild("HumanoidRootPart", 10)
  task.wait()
  if states[player] ~= data or data._workVersion ~= version or not player.Parent
    or player.Character ~= character or not character.Parent
    or not humanoid or humanoid.Health <= 0 or not root then return false end
  restore(player, data, character, humanoid, root)
  return true
end

local function bindPlayerLifecycle(players, states, makeState, restore, release)
  local function added(player)
    local data = states[player] or makeState(player)
    if data._characterConnection then return end
    states[player] = data
    local function characterAdded(character)
      if player.Character ~= character or data._character == character then return end
      local version = invalidatePlayerWork(data)
      if data._character then release(player, data) end
      data._character = character
      task.spawn(restoreCurrentCharacter, states, player, character, version, restore)
    end
    data._characterConnection = player.CharacterAdded:Connect(characterAdded)
    data._removingConnection = player.CharacterRemoving:Connect(function(character)
      if data._character ~= character then return end
      data._character = nil
      invalidatePlayerWork(data)
      release(player, data)
    end)
    if player.Character then characterAdded(player.Character) end
  end
  players.PlayerAdded:Connect(added)
  players.PlayerRemoving:Connect(function(player)
    local data = states[player]
    if not data then return end
    states[player] = nil
    invalidatePlayerWork(data)
    data._characterConnection:Disconnect()
    data._removingConnection:Disconnect()
    data._characterConnection = nil
    data._removingConnection = nil
    release(player, data)
  end)
  for _, player in ipairs(players:GetPlayers()) do added(player) end
end
local function clearPlayerCleanup(data, key)
  local cleanups = data._interactionCleanup
  if not cleanups then return end
  local function run(entry)
    local ok, message = pcall(entry.callback)
    if not ok then warn("Interaction cleanup failed: " .. tostring(message)) end
  end
  if key ~= nil then
    local entry = cleanups[key]
    cleanups[key] = nil
    if entry then run(entry) end
  else
    data._interactionCleanup = nil
    for _, entry in pairs(cleanups) do run(entry) end
  end
end

local function addPlayerCleanup(data, key, callback)
  assert(key ~= nil and type(callback) == "function", "Supply an interaction key and cleanup callback")
  clearPlayerCleanup(data, key)
  data._interactionCleanup = data._interactionCleanup or {}
  local entry = {callback = callback}
  data._interactionCleanup[key] = entry
  return function()
    if data._interactionCleanup and data._interactionCleanup[key] == entry then
      clearPlayerCleanup(data, key)
    end
  end
end

local invalidatePreviousPlayerWork = invalidatePlayerWork
local function invalidatePlayerWork(data)
  local version = invalidatePreviousPlayerWork(data)
  clearPlayerCleanup(data)
  return version
end

local function bindPlayerLifecycle(players, states, makeState, restore, release)
  local function added(player)
    local data = states[player] or makeState(player)
    if data._characterConnection then return end
    states[player] = data
    local function releaseCharacter(character)
      if data._character ~= character or data._releasedCharacter == character then return end
      data._releasedCharacter = character
      if data._deathConnection then data._deathConnection:Disconnect(); data._deathConnection = nil end
      invalidatePlayerWork(data)
      release(player, data)
    end
    local function characterAdded(character)
      if player.Character ~= character or data._character == character then return end
      if data._character then releaseCharacter(data._character) end
      data._character = character
      data._releasedCharacter = nil
      local version = invalidatePlayerWork(data)
      -- Death belongs to the character lifetime, not a resettable restoration task.
      -- A reset during character readiness must not cancel its only death listener.
      local function bindDeath(humanoid)
        if not humanoid or states[player] ~= data or data._character ~= character
          or player.Character ~= character or not player.Parent then return end
        data._deathConnection = humanoid.Died:Connect(function() releaseCharacter(character) end)
        if humanoid.Health <= 0 then releaseCharacter(character) end
      end
      local humanoid = character:FindFirstChildOfClass("Humanoid")
      if humanoid then bindDeath(humanoid)
      else task.spawn(function() bindDeath(character:WaitForChild("Humanoid", 10)) end) end
      task.spawn(restoreCurrentCharacter, states, player, character, version, restore)
    end
    data._characterConnection = player.CharacterAdded:Connect(characterAdded)
    data._removingConnection = player.CharacterRemoving:Connect(function(character)
      if data._character ~= character then return end
      releaseCharacter(character)
      data._character = nil
    end)
    if player.Character then characterAdded(player.Character) end
  end
  players.PlayerAdded:Connect(added)
  players.PlayerRemoving:Connect(function(player)
    local data = states[player]
    if not data then return end
    invalidatePlayerWork(data)
    if data._deathConnection then data._deathConnection:Disconnect(); data._deathConnection = nil end
    data._characterConnection:Disconnect()
    data._removingConnection:Disconnect()
    data._characterConnection = nil
    data._removingConnection = nil
    -- The callback receives the same row while it is still available. It must use this
    -- argument for ownership checks; a previously dead character may already be released.
    release(player, data)
    states[player] = nil
  end)
  for _, player in ipairs(players:GetPlayers()) do added(player) end
end
local inputBindingSerial = 0
local function bindInputActions(actions, onChanged)
  local CAS = game:GetService("ContextActionService")
  local UIS = game:GetService("UserInputService")
  assert(game:GetService("RunService"):IsClient(), "bindInputActions is client-only")
  inputBindingSerial += 1
  local prefix = "PromptBloxInput:" .. inputBindingSerial .. ":"
  local rows, ids, connections = {}, {}, {}
  local enabled, destroyed, focused = false, false, true
  for _, action in ipairs(actions) do
    assert(type(action.id) == "string" and not ids[action.id], "Input action IDs must be unique strings")
    assert(type(action.inputs) == "table" and #action.inputs > 0, "Input action needs keys or input types")
    ids[action.id] = true
    table.insert(rows, {id = action.id, name = prefix .. action.id, inputs = table.clone(action.inputs),
      touchTitle = action.touchTitle, touchPosition = action.touchPosition, pressed = {}})
  end
  local function emit(reason, id)
    local snapshot = {}
    for _, row in ipairs(rows) do snapshot[row.id] = next(row.pressed) ~= nil end
    onChanged(snapshot, reason, id)
  end
  local function releaseAll(reason)
    for _, row in ipairs(rows) do table.clear(row.pressed) end
    emit(reason)
  end
  local controller = {}
  function controller.setEnabled(value)
    if destroyed or enabled == (value == true) then return end
    enabled = value == true
    if enabled then
      for _, row in ipairs(rows) do
        CAS:BindAction(row.name, function(_, state, input)
          if destroyed or not enabled then return Enum.ContextActionResult.Pass end
          if state == Enum.UserInputState.Begin and (not focused or UIS:GetFocusedTextBox()) then
            return Enum.ContextActionResult.Pass
          end
          local wasDown = next(row.pressed) ~= nil
          local key = input.UserInputType == Enum.UserInputType.Touch and input
            or (input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode or input.UserInputType)
          local reason
          if state == Enum.UserInputState.Begin then row.pressed[key] = true; reason = "begin"
          elseif state == Enum.UserInputState.End then row.pressed[key] = nil; reason = "end"
          elseif state == Enum.UserInputState.Cancel then table.clear(row.pressed); reason = "cancel" end
          if wasDown ~= (next(row.pressed) ~= nil) then emit(reason, row.id) end
          return Enum.ContextActionResult.Sink
        end, row.touchTitle ~= nil, table.unpack(row.inputs))
        if row.touchTitle ~= nil then
          CAS:SetTitle(row.name, row.touchTitle)
          if row.touchPosition ~= nil then CAS:SetPosition(row.name, row.touchPosition) end
        end
      end
      emit("enabled")
    else
      for _, row in ipairs(rows) do CAS:UnbindAction(row.name) end
      releaseAll("disabled")
    end
  end
  function controller.clear()
    if not destroyed then releaseAll("clear") end
  end
  function controller.resend()
    if enabled and not destroyed then emit("resend") end
  end
  function controller.destroy()
    if destroyed then return end
    destroyed = true
    enabled = false
    for _, connection in ipairs(connections) do connection:Disconnect() end
    for _, row in ipairs(rows) do CAS:UnbindAction(row.name) end
    releaseAll("destroyed")
  end
  table.insert(connections, UIS.WindowFocusReleased:Connect(function()
    focused = false
    if enabled then releaseAll("focus") end
  end))
  table.insert(connections, UIS.WindowFocused:Connect(function() focused = true end))
  table.insert(connections, UIS.TextBoxFocused:Connect(function()
    if enabled then releaseAll("focus") end
  end))
  return table.freeze(controller)
end
local function bindHeldInput(actions, remote, command)
  assert(typeof(remote) == "Instance" and remote:IsA("RemoteEvent"), "Held input needs a RemoteEvent")
  assert(type(command) == "string" and #command > 0, "Held input needs a command")
  return bindInputActions(actions, function(snapshot)
    remote:FireServer(command, snapshot)
  end)
end

local function applyHeldInput(state, snapshot)
  if type(state) ~= "table" or type(snapshot) ~= "table" then return false end
  for id, value in pairs(state) do
    if type(id) ~= "string" or type(value) ~= "boolean" or type(snapshot[id]) ~= "boolean" then
      return false
    end
  end
  for id in pairs(snapshot) do
    if type(id) ~= "string" or type(state[id]) ~= "boolean" then return false end
  end
  for id in pairs(state) do state[id] = snapshot[id] end
  return true
end

local function attachControlFrame(root, facing)
  assert(typeof(root) == "Instance" and root:IsA("BasePart"), "Control frame root must be a BasePart")
  assert(typeof(facing) == "CFrame", "Control facing must be a world CFrame")
  local attachment = Instance.new("Attachment")
  attachment.Name = "PromptBloxControlFrame"
  attachment.CFrame = root.CFrame.Rotation:ToObjectSpace(facing.Rotation)
  attachment.Parent = root
  return attachment
end
local groundMoverOwners = setmetatable({}, {__mode = "k"})
local function actorFacing(direction)
  local forward = Vector3.new(direction.X, 0, direction.Z)
  if forward.Magnitude < 0.001 then return CFrame.identity end
  forward = forward.Unit
  return CFrame.fromMatrix(Vector3.zero, forward:Cross(Vector3.yAxis), Vector3.yAxis, -forward)
end

-- Standing placement is derived from visual bounds, not the arbitrary PrimaryPart pivot.
local function placeActor(model, floorFrame, floorToPivot)
  assert(typeof(model) == "Instance" and model:IsA("Model"), "Actor placement requires a Model")
  assert(typeof(floorFrame) == "CFrame", "Supply the actor's supported floor frame")
  assert(game:GetService("RunService"):IsServer(), "Actor placement is server-only")
  if floorToPivot == nil then
    local pivot = model:GetPivot()
    local facing = actorFacing(pivot.LookVector)
    local upright = CFrame.new(pivot.Position) * facing
    local boxFrame, boxSize = model:GetBoundingBox()
    assert(boxSize.X > 0 and boxSize.Y > 0 and boxSize.Z > 0, "Actor requires visual parts")
    local low, high = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
    for _, x in ipairs({-0.5, 0.5}) do
      for _, y in ipairs({-0.5, 0.5}) do
        for _, z in ipairs({-0.5, 0.5}) do
          local p = upright:PointToObjectSpace(boxFrame:PointToWorldSpace(boxSize * Vector3.new(x, y, z)))
          low = Vector3.new(math.min(low.X, p.X), math.min(low.Y, p.Y), math.min(low.Z, p.Z))
          high = Vector3.new(math.max(high.X, p.X), math.max(high.Y, p.Y), math.max(high.Z, p.Z))
        end
      end
    end
    local support = upright * CFrame.new((low.X + high.X) / 2, low.Y, (low.Z + high.Z) / 2)
    floorToPivot = support:ToObjectSpace(pivot)
  end
  assert(typeof(floorToPivot) == "CFrame", "floorToPivot must be a CFrame")
  model:PivotTo(floorFrame * floorToPivot)
  return floorToPivot
end

local function createGroundMover(model, groundFrame, options)
  options = options or {}
  assert(typeof(model) == "Instance" and model:IsA("Model"), "Ground mover requires an actor Model")
  local pathfinding, world = game:GetService("PathfindingService"), game:GetService("Workspace")
  local activationParent = options.parent
  if activationParent == nil then
    assert(model.Parent == nil or model:IsDescendantOf(world),
      "Stored actor is not active: clone it, or supply an explicit Workspace parent")
    activationParent = model.Parent or world
  end
  assert(typeof(activationParent) == "Instance" and (activationParent == world or activationParent:IsDescendantOf(world)),
    "Actor parent must be Workspace or one of its descendants")
  assert(activationParent ~= model and not activationParent:IsDescendantOf(model), "Actor parent cannot be inside the actor")
  for _, key in ipairs({"speed", "radius", "height"}) do
    local value = options[key]
    assert(value == nil or (type(value) == "number" and value > 0 and value < math.huge),
      "Ground mover " .. key .. " must be a finite positive number")
  end
  local pivotOffset = placeActor(model, groundFrame, options.floorToPivot)
  local boxFrame, boxSize = model:GetBoundingBox()
  local radius, height = 0, 0
  for _, x in ipairs({-0.5, 0.5}) do
    for _, y in ipairs({-0.5, 0.5}) do
      for _, z in ipairs({-0.5, 0.5}) do
        local p = groundFrame:PointToObjectSpace(boxFrame:PointToWorldSpace(boxSize * Vector3.new(x, y, z)))
        radius = math.max(radius, Vector3.new(p.X, 0, p.Z).Magnitude)
        height = math.max(height, p.Y)
      end
    end
  end
  radius, height = math.ceil(options.radius or radius), math.ceil(options.height or height)
  local speed = options.speed or 10
  assert(radius > 0 and height > 0 and speed > 0, "Ground mover dimensions and speed must be positive")
  for _, part in ipairs(model:GetDescendants()) do
    if part:IsA("BasePart") then part.Anchored = true; part.CanCollide = false end
  end
  local rayParams = RaycastParams.new()
  rayParams.FilterType = Enum.RaycastFilterType.Exclude
  rayParams.FilterDescendantsInstances = {model}
  rayParams.RespectCanCollide = true
  local current, facing = groundFrame.Position, groundFrame.Rotation
  local target, plannedTarget, waypoints, path, blockedConnection, ancestryConnection, controller
  local followObject, followDistance, joinRejectedAt
  local waypointIndex, generation, elapsed, nextComputeAt = 1, 0, 0, 0
  local computing, dirty, destroyed, status = false, false, false, "idle"
  local stepHeight, repathDistance = 1.5, math.max(2, radius)
  local function clearPath()
    if blockedConnection then blockedConnection:Disconnect(); blockedConnection = nil end
    if path then path:Destroy(); path = nil end
    waypoints, waypointIndex = nil, 1
  end
  local function stop()
    generation += 1
    target, plannedTarget, dirty = nil, nil, false
    followObject, followDistance, joinRejectedAt = nil, nil, nil
    clearPath()
    status = "idle"
  end
  local function destroy()
    if destroyed then return end
    stop()
    destroyed, status = true, "destroyed"
    if ancestryConnection then ancestryConnection:Disconnect(); ancestryConnection = nil end
    if groundMoverOwners[model] == controller then groundMoverOwners[model] = nil end
  end
  local function isActive()
    if destroyed then return false end
    if not model:IsDescendantOf(world) then destroy(); return false end
    return true
  end
  local function unreachable()
    clearPath()
    dirty, status = false, "unreachable"
  end
  local function changed(a, b)
    if not a or not b or a.object ~= b.object or a.distance ~= b.distance then return true end
    if (a.position - b.position).Magnitude > repathDistance then return true end
    return a.object ~= nil and ((a.size - b.size).Magnitude > 0.1 or a.frame.LookVector:Dot(b.frame.LookVector) < 0.98)
  end
  local function arrived(destination, fromGround)
    local standing = fromGround or current
    if not destination.object then return (destination.position - standing).Magnitude <= 0.1 end
    if not destination.object.Parent then return false end
    -- Measure reach from the actor body, so low switches are not treated as
    -- distant merely because an arbitrary chest-height point is above them.
    local bodyY = math.clamp(destination.position.Y - standing.Y, 0.1, height)
    local body = standing + Vector3.new(0, bodyY, 0)
    local p = destination.frame:PointToObjectSpace(body)
    local half = destination.size * 0.5
    local surface = destination.frame:PointToWorldSpace(Vector3.new(
      math.clamp(p.X, -half.X, half.X), math.clamp(p.Y, -half.Y, half.Y), math.clamp(p.Z, -half.Z, half.Z)))
    local delta = surface - body
    if delta.Magnitude > radius + destination.distance + 0.1 then return false end
    if delta.Magnitude < 0.001 then return true end
    local hit = world:Raycast(body, delta, rayParams)
    return not hit or hit.Instance == destination.object or hit.Instance:IsDescendantOf(destination.object)
  end
  local function approaches(destination)
    if not destination.object then return {destination.position} end
    local frame, half = destination.frame, destination.size * 0.5
    local p = frame:PointToObjectSpace(current)
    local gap = radius + destination.distance
    local x, z = math.clamp(p.X, -half.X, half.X), math.clamp(p.Z, -half.Z, half.Z)
    local points = {}
    for _, offset in ipairs({Vector3.new(-half.X-gap, 0, z), Vector3.new(half.X+gap, 0, z),
      Vector3.new(x, 0, -half.Z-gap), Vector3.new(x, 0, half.Z+gap)}) do
      local point = frame:PointToWorldSpace(offset)
      -- Start below overhead scenery when possible. A path still has to prove a
      -- walking route to this floor; projection alone never authorizes movement.
      local top = math.max(current.Y + stepHeight + 0.05, point.Y)
      local hit = world:Raycast(Vector3.new(point.X, top, point.Z),
        Vector3.new(0, -math.max(64, height + destination.size.Y), 0), rayParams)
      if hit and hit.Normal.Y >= 0.5 and arrived(destination, hit.Position) then table.insert(points, hit.Position) end
    end
    table.sort(points, function(a, b) return (a-current).Magnitude < (b-current).Magnitude end)
    return points
  end
  local function compute()
    if computing or not target or not dirty or elapsed < nextComputeAt then return end
    -- A rejected splice may retry after real movement, or once from the final
    -- stopped position. It cannot repeatedly compute from an unchanged failure.
    if joinRejectedAt and waypoints and (current - joinRejectedAt).Magnitude < repathDistance then return end
    dirty, joinRejectedAt = false, nil
    if target.object and not target.object.Parent then unreachable(); return end
    if arrived(target) then clearPath(); status = "arrived"; plannedTarget = target; return end
    computing = true
    nextComputeAt = elapsed + 0.75
    local requestGeneration, destination, start = generation, target, current
    plannedTarget = destination
    if not waypoints then status = "computing" end
    task.spawn(function()
      local candidate, route
      -- At most four genuine approaches, one native request at a time. A failed
      -- stationary destination stays failed until it changes or the game retries.
      for _, goal in ipairs(approaches(destination)) do
        if not isActive() or requestGeneration ~= generation or not target then break end
        local attempt
        local ok = pcall(function()
          attempt = pathfinding:CreatePath({AgentRadius = radius, AgentHeight = height,
            AgentCanJump = false, AgentCanClimb = false, WaypointSpacing = 4})
          attempt:ComputeAsync(start, goal)
        end)
        if not isActive() or requestGeneration ~= generation or not target then
          if attempt then attempt:Destroy() end
          break
        end
        local points = ok and attempt.Status == Enum.PathStatus.Success and attempt:GetWaypoints() or nil
        local walking = points ~= nil and #points >= 2
        if walking then
          for _, waypoint in ipairs(points) do
            if waypoint.Action ~= Enum.PathWaypointAction.Walk then walking = false; break end
          end
        end
        if walking then candidate, route = attempt, points; break end
        if attempt then attempt:Destroy() end
      end
      computing = false
      if not isActive() or requestGeneration ~= generation or not target then
        if candidate then candidate:Destroy() end
        return
      end
      if not candidate then
        -- A failed replacement does not invalidate the still-walkable current
        -- route. Finish that route, then report failure if the goal is not reached.
        dirty = false
        if not waypoints then unreachable() end
        return
      end
      local joinIndex = 2
      if (current - start).Magnitude > 0.1 then
        -- The actor kept walking while ComputeAsync yielded. Join the nearest
        -- segment only when the whole body has a clear connection to its next
        -- waypoint; otherwise keep the old route rather than cutting a corner.
        local nearest = math.huge
        for index = 2, #route do
          local a, b = route[index-1].Position, route[index].Position
          local segment = b - a
          local fraction = segment.Magnitude > 0.001 and math.clamp((current-a):Dot(segment) / segment:Dot(segment), 0, 1) or 0
          local distance = (current - (a + segment * fraction)).Magnitude
          if distance < nearest then nearest, joinIndex = distance, index end
        end
        local delta = route[joinIndex].Position - current
        local body = CFrame.new(current + Vector3.new(0, height * 0.5 + 0.05, 0))
        local size = Vector3.new(radius * 2, math.max(0.1, height - 0.1), radius * 2)
        if delta.Magnitude > 0.05 and world:Blockcast(body, size, delta, rayParams) then
          candidate:Destroy()
          joinRejectedAt, dirty = current, waypoints ~= nil
          status = waypoints and "moving" or "unreachable"
          return
        end
      end
      clearPath()
      path, waypoints, waypointIndex, status = candidate, route, joinIndex, "moving"
      if changed(target, destination) then dirty = true end
      nextComputeAt = math.max(nextComputeAt, elapsed + 0.25)
      blockedConnection = candidate.Blocked:Connect(function(index)
        if path == candidate and index >= waypointIndex then unreachable() end
      end)
    end)
  end
  local function updateTarget(destination, approachOptions)
    if not isActive() then return end
    if destination == nil then stop(); return end
    local nextTarget
    if typeof(destination) == "Vector3" then
      nextTarget = {position = destination}
    else
      assert(typeof(destination) == "Instance" and (destination:IsA("BasePart") or destination:IsA("Model")),
        "Target must be a walkable floor Vector3 or an approachable BasePart/Model")
      local frame, size
      if destination:IsA("BasePart") then frame, size = destination.CFrame, destination.Size
      else frame, size = destination:GetBoundingBox() end
      local distance = approachOptions and approachOptions.arrivalDistance or 1
      assert(type(distance) == "number" and distance >= 0 and distance < math.huge, "arrivalDistance must be nonnegative")
      nextTarget = {object = destination, frame = frame, size = size, position = frame.Position, distance = distance}
    end
    -- Object identity changes cancel obsolete work. Repeated floor Vector3s
    -- update the same destination; callers can explicitly stop before replacing it.
    local replace = not target or target.object ~= nextTarget.object
    target = nextTarget
    if replace then
      generation += 1
      clearPath()
      dirty, status = true, "computing"
    elseif changed(plannedTarget, target) then
      dirty = true
      if not waypoints then status = "computing" end
    elseif status == "arrived" and not arrived(target) then
      -- A small move after arrival needs a fresh route, but unchanged failures do not.
      dirty, status = true, "computing"
    end
  end
  local function setTarget(destination, approachOptions)
    followObject, followDistance = nil, nil
    updateTarget(destination, approachOptions)
  end
  local function setFollowTarget(object, arrivalDistance)
    if not isActive() then return end
    if object == nil then setTarget(nil); return end
    assert(typeof(object) == "Instance" and (object:IsA("BasePart") or object:IsA("Model")),
      "Follow target must be a BasePart or Model, not its elevated Position")
    updateTarget(object, {arrivalDistance = arrivalDistance})
    followObject, followDistance = object, arrivalDistance
  end
  local function step(dt)
    if not isActive() then return "destroyed" end
    if type(dt) ~= "number" or dt <= 0 or dt ~= dt or dt == math.huge then return status end
    elapsed += dt
    if followObject then
      if not followObject.Parent then unreachable(); return status end
      updateTarget(followObject, {arrivalDistance = followDistance})
    end
    if target and target.object and not target.object.Parent then unreachable(); return status end
    if target and target.object and arrived(target) then
      if computing then generation += 1 end
      clearPath(); dirty, status = false, "arrived"; plannedTarget = target
      return status
    end
    compute()
    if not waypoints or not target then return status end
    local distanceLeft = speed * math.min(dt, 0.25)
    while distanceLeft > 0 and waypoints do
      local waypoint = waypoints[waypointIndex]
      if not waypoint then
        clearPath()
        if arrived(target) then status = "arrived"
        elseif computing or dirty then status = "computing"
        else unreachable() end
        break
      end
      local delta = Vector3.new(waypoint.Position.X - current.X, 0, waypoint.Position.Z - current.Z)
      if delta.Magnitude < 0.05 then
        waypointIndex += 1
      else
        local travel = math.min(distanceLeft, delta.Magnitude, 0.75)
        local horizontal = current + delta.Unit * travel
        local hit = world:Raycast(horizontal + Vector3.new(0, stepHeight + 0.05, 0),
          Vector3.new(0, -(stepHeight * 2 + 0.1), 0), rayParams)
        if not hit or hit.Normal.Y < 0.5 or math.abs(hit.Position.Y - current.Y) > stepHeight then unreachable(); break end
        current = Vector3.new(horizontal.X, hit.Position.Y, horizontal.Z)
        facing = actorFacing(delta)
        model:PivotTo(CFrame.new(current) * facing * pivotOffset)
        distanceLeft -= travel
      end
    end
    return status
  end
  controller = table.freeze({
    setTarget = setTarget, setFollowTarget = setFollowTarget, step = step,
    position = function() return current end,
    retry = function()
      if not isActive() or not target then return end
      generation += 1
      clearPath()
      dirty, status = true, "computing"
    end,
    reset = function(frame)
      if not isActive() then return end
      assert(typeof(frame) == "CFrame", "Reset requires a standing ground frame")
      stop()
      current, facing, nextComputeAt = frame.Position, frame.Rotation, elapsed
      model:PivotTo(frame * pivotOffset)
    end,
    destroy = destroy,
  })
  -- The actor remains unpublished until placement, navigation setup and controller
  -- construction have all succeeded. Runtime removal permanently retires this owner.
  ancestryConnection = model.AncestryChanged:Connect(function(_, parent)
    -- Use the event parent too: a deferred removal event must still retire this
    -- controller if another script already put the actor back into the world.
    if parent == nil or (parent ~= world and not parent:IsDescendantOf(world)) then destroy()
    else isActive() end
  end)
  local published, failure = pcall(function()
    if model.Parent ~= activationParent then model.Parent = activationParent end
  end)
  if not published then destroy(); error(failure, 2) end
  assert(isActive(), "Actor left Workspace during activation")
  local previous = groundMoverOwners[model]
  groundMoverOwners[model] = controller
  if previous then previous.destroy() end
  return controller
end
local characterMovementKey = {}

local function characterDestination(character, humanoid, root, floorFrame)
  if typeof(floorFrame) ~= "CFrame" then return nil end
  for _, value in ipairs({floorFrame:GetComponents()}) do
    if value ~= value or math.abs(value) == math.huge then return nil end
  end
  local height = root.Size.Y * 0.5 + humanoid.HipHeight
  if humanoid.RigType == Enum.HumanoidRigType.R6 then
    local leg = character:FindFirstChild("Left Leg")
    if not leg or not leg:IsA("BasePart") then return nil end
    height += leg.Size.Y
  end
  local look = Vector3.new(floorFrame.LookVector.X, 0, floorFrame.LookVector.Z)
  if look.Magnitude < 0.000001 then
    local right = Vector3.new(floorFrame.RightVector.X, 0, floorFrame.RightVector.Z)
    look = Vector3.yAxis:Cross(right)
  end
  local targetRoot = CFrame.new(floorFrame.Position + Vector3.yAxis * height)
    * CFrame.Angles(0, math.atan2(-look.X, -look.Z), 0)
  local relative = root.CFrame:ToObjectSpace(character:GetPivot())
  local minimum, maximum = Vector3.one * math.huge, Vector3.one * -math.huge
  for _, part in ipairs(character:GetChildren()) do
    -- Rig body parts are direct children. Accessory/Tool handles are cosmetic clearance.
    if part:IsA("BasePart") then
      local frame, half = root.CFrame:ToObjectSpace(part.CFrame), part.Size * 0.5
      local right, up, look = frame.RightVector, frame.UpVector, frame.LookVector
      local extent = Vector3.new(
        math.abs(right.X) * half.X + math.abs(up.X) * half.Y + math.abs(look.X) * half.Z,
        math.abs(right.Y) * half.X + math.abs(up.Y) * half.Y + math.abs(look.Y) * half.Z,
        math.abs(right.Z) * half.X + math.abs(up.Z) * half.Y + math.abs(look.Z) * half.Z)
      minimum = minimum:Min(frame.Position - extent)
      maximum = maximum:Max(frame.Position + extent)
    end
  end
  -- HipHeight defines the standing floor even while a leg animation extends below it.
  minimum = Vector3.new(minimum.X, math.max(minimum.Y, -height), minimum.Z)
  local size = maximum - minimum
  if size.X <= 0 or size.Y <= 0 or size.Z <= 0 then return nil end
  local targetBounds = targetRoot * CFrame.new((minimum + maximum) * 0.5)
  local params = OverlapParams.new()
  params.FilterType = Enum.RaycastFilterType.Exclude
  params.FilterDescendantsInstances = {character}
  params.RespectCanCollide = true
  params.CollisionGroup = root.CollisionGroup
  params.MaxParts = 1
  -- A numerical contact tolerance keeps the supporting floor out of the body query.
  local tolerance = math.min(0.02, size.X * 0.01, size.Y * 0.01, size.Z * 0.01)
  size -= Vector3.one * tolerance
  if #game:GetService("Workspace"):GetPartBoundsInBox(targetBounds, size, params) > 0 then return nil end
  return targetRoot * relative
end

local function clearCharacterVelocity(character)
  for _, part in ipairs(character:GetDescendants()) do
    if part:IsA("BasePart") then
      part.AssemblyLinearVelocity = Vector3.zero
      part.AssemblyAngularVelocity = Vector3.zero
    end
  end
end

local function moveCharacter(character, humanoid, destination)
  humanoid.Sit = false
  clearCharacterVelocity(character)
  character:PivotTo(destination)
end

local function placePlayer(states, player, floorFrame)
  assert(game:GetService("RunService"):IsServer(), "Character placement is server-only")
  local data, character, humanoid, root = getLivePlayer(states, player)
  if not data or data._characterMovementTransition then return false end
  local destination = characterDestination(character, humanoid, root, floorFrame)
  if not destination then return false end
  clearPlayerCleanup(data, characterMovementKey)
  local current, currentCharacter, currentHumanoid, currentRoot = getLivePlayer(states, player)
  if current ~= data or currentCharacter ~= character or currentHumanoid ~= humanoid or currentRoot ~= root then return false end
  humanoid.PlatformStand = false
  moveCharacter(character, humanoid, destination)
  return true
end

local function holdPlayer(states, player, floorFrame, onRelease)
  assert(game:GetService("RunService"):IsServer(), "Character ownership is server-only")
  if onRelease ~= nil and type(onRelease) ~= "function" then return nil end
  local data, character, humanoid, root = getLivePlayer(states, player)
  if not data or data._characterMovementTransition then return nil end
  local destination = characterDestination(character, humanoid, root, floorFrame)
  if not destination then return nil end
  clearPlayerCleanup(data, characterMovementKey)
  local current, currentCharacter, currentHumanoid, currentRoot = getLivePlayer(states, player)
  if current ~= data or currentCharacter ~= character or currentHumanoid ~= humanoid or currentRoot ~= root then return nil end
  local anchored, walkSpeed, jumpPower, jumpHeight, autoRotate = root.Anchored,
    humanoid.WalkSpeed, humanoid.JumpPower, humanoid.JumpHeight, humanoid.AutoRotate
  local held = true
  local cleanup = addPlayerCleanup(data, characterMovementKey, function()
    held = false
    local previousTransition = data._characterMovementTransition
    data._characterMovementTransition = true
    local ok, message = pcall(function()
      clearCharacterVelocity(character)
      if root:IsDescendantOf(character) then root.Anchored = anchored end
      if humanoid:IsDescendantOf(character) then
        humanoid.WalkSpeed, humanoid.JumpPower, humanoid.JumpHeight, humanoid.AutoRotate =
          walkSpeed, jumpPower, jumpHeight, autoRotate
      end
      if onRelease then onRelease() end
    end)
    data._characterMovementTransition = previousTransition
    if not ok then error(message, 0) end
  end)
  local controller = {}
  function controller.active()
    if not held then return false end
    local live, liveCharacter, liveHumanoid, liveRoot = getLivePlayer(states, player)
    if live ~= data or liveCharacter ~= character or liveHumanoid ~= humanoid or liveRoot ~= root then
      cleanup()
      return false
    end
    return true
  end
  function controller.move(nextFloorFrame)
    if not controller.active() then return false end
    local nextDestination = characterDestination(character, humanoid, root, nextFloorFrame)
    if not nextDestination then return false end
    moveCharacter(character, humanoid, nextDestination)
    return true
  end
  function controller.release(exitFloorFrame)
    if not controller.active() then return false end
    local moved = true
    if exitFloorFrame ~= nil then moved = controller.move(exitFloorFrame) end
    cleanup()
    return moved
  end
  root.Anchored = true
  humanoid.WalkSpeed, humanoid.JumpPower, humanoid.JumpHeight, humanoid.AutoRotate = 0, 0, 0, false
  moveCharacter(character, humanoid, destination)
  return controller
end
local function createFeedbackPulse(target, goals, seconds)
  assert(typeof(target) == "Instance" and type(goals) == "table" and next(goals) ~= nil,
    "Feedback needs an instance and visual property goals")
  seconds = seconds or 0.12
  assert(type(seconds) == "number" and seconds > 0 and seconds < math.huge, "Feedback duration must be positive and finite")
  local TweenService = game:GetService("TweenService")
  local info = TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true)
  local properties = table.clone(goals)
  local tween, completed, death, baseline = nil, nil, nil, nil
  local connections, destroyed = {}, false
  local controller = {}
  local function stop(restore)
    local previous, original = tween, baseline
    tween, baseline = nil, nil
    if completed then completed:Disconnect(); completed = nil end
    if death then death:Disconnect(); death = nil end
    if previous then previous:Cancel(); previous:Destroy() end
    if restore and original then
      for property, value in pairs(original) do target[property] = value end
    end
  end
  function controller.play()
    if destroyed or not target.Parent then return false end
    local humanoid
    if target:IsA("Tool") then
      humanoid = target.Parent:FindFirstChildOfClass("Humanoid")
      if not humanoid or humanoid.Health <= 0 then return false end
    end
    stop(true)
    baseline = {}
    for property in pairs(properties) do baseline[property] = target[property] end
    local current = TweenService:Create(target, info, properties)
    tween = current
    completed = current.Completed:Connect(function(state)
      if tween ~= current then return end
      -- An external animator cancelling our tween owns the resulting pose. Do not
      -- overwrite it. Explicit cancel/unequip/reset restores our own baseline.
      stop(state == Enum.PlaybackState.Completed)
    end)
    if humanoid then death = humanoid.Died:Connect(function() stop(true) end) end
    current:Play()
    return true
  end
  function controller.cancel()
    if not destroyed then stop(true) end
  end
  function controller.destroy()
    if destroyed then return end
    destroyed = true
    stop(true)
    for _, connection in ipairs(connections) do connection:Disconnect() end
    table.clear(connections)
  end
  table.insert(connections, target.Destroying:Connect(controller.destroy))
  if target:IsA("Tool") then
    table.insert(connections, target.Unequipped:Connect(controller.cancel))
  end
  return table.freeze(controller)
end

local function replacePlayerTool(states, player, newTool)
  assert(game:GetService("RunService"):IsServer(), "replacePlayerTool is server-only")
  if typeof(newTool) ~= "Instance" or not newTool:IsA("Tool") or newTool.Parent then return false end
  local data, character, humanoid = getLivePlayer(states, player)
  local backpack = player:FindFirstChildOfClass("Backpack")
  if not data or not backpack then return false end
  local previous, equipped = {}, nil
  for _, container in ipairs({character, backpack}) do
    for _, child in ipairs(container:GetChildren()) do
      if child:IsA("Tool") and child.Name == newTool.Name then
        table.insert(previous, child)
        if container == character and not equipped then equipped = child end
      end
    end
  end
  local function isCurrent()
    local current, currentCharacter, currentHumanoid = getLivePlayer(states, player)
    return current == data and currentCharacter == character and currentHumanoid == humanoid
      and backpack.Parent == player
  end
  newTool.Parent = backpack
  if not isCurrent() then newTool.Parent = nil; return false end
  local installed = true
  if equipped then installed = pcall(function() humanoid:EquipTool(newTool) end) end
  if not installed or not isCurrent() or newTool.Parent ~= (equipped and character or backpack) then
    newTool.Parent = nil
    if equipped and isCurrent() and equipped.Parent == backpack then
      pcall(function() humanoid:EquipTool(equipped) end)
    end
    return false
  end
  for _, oldTool in ipairs(previous) do
    if oldTool.Parent == character or oldTool.Parent == backpack then oldTool:Destroy() end
  end
  return true
end

local healthObservationKey = {}
local function observeHealth(data, humanoid, onChanged)
  clearPlayerCleanup(data, healthObservationKey)
  local active, connections = true, {}
  local cleanup = addPlayerCleanup(data, healthObservationKey, function()
    active = false
    for _, connection in ipairs(connections) do connection:Disconnect() end
  end)
  local function publish()
    if active then onChanged(humanoid.Health, humanoid.MaxHealth) end
  end
  table.insert(connections, humanoid.HealthChanged:Connect(publish))
  table.insert(connections, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(publish))
  table.insert(connections, humanoid.Destroying:Connect(cleanup))
  publish()
  return cleanup
end
local function bindPlayerLifecycle(players, states, makeState, restore, release)
  assert(game:GetService("RunService"):IsServer(), "bindPlayerLifecycle is server-only")
  local records, connections, destroyed = {}, {}, false
  local controller = {}
  local function current(player, entry)
    return not destroyed and records[player] == entry and states[player] == entry.data and player.Parent == players
  end
  local function releaseParticipation(player, entry)
    local data = entry.data
    local version = invalidatePlayerWork(data)
    if not entry.released then
      entry.released = true
      data._releasedCharacter = entry.character
      local ok, message = pcall(release, player, data)
      if not ok then warn("Player release failed: " .. tostring(message)) end
    end
    return version
  end
  local function disconnectDeath(entry)
    if entry.data._deathConnection then
      entry.data._deathConnection:Disconnect()
      entry.data._deathConnection = nil
    end
  end
  local function scheduleRestore(player, entry, character, version)
    task.spawn(restoreCurrentCharacter, states, player, character, version, function(...)
      if current(player, entry) and entry.character == character and not entry.released then restore(...) end
    end)
  end
  local function remove(player, entry)
    if records[player] ~= entry then return end
    records[player] = nil
    local data = entry.data
    disconnectDeath(entry)
    data._characterConnection:Disconnect()
    data._removingConnection:Disconnect()
    data._characterConnection, data._removingConnection = nil, nil
    releaseParticipation(player, entry)
    data._character = nil
    if states[player] == data then states[player] = nil end
  end
  local function added(player)
    if destroyed or player.Parent ~= players or records[player] then return end
    local data = states[player] or makeState(player)
    if data._characterConnection then return end
    states[player] = data
    local entry = {data = data, released = false, character = nil, resetting = false, dead = false, characterEpoch = 0}
    records[player] = entry
    local function characterAdded(character)
      if not current(player, entry) or player.Character ~= character or entry.character == character then return end
      if entry.character then releaseParticipation(player, entry) end
      disconnectDeath(entry)
      entry.character, entry.released, entry.dead = character, false, false
      entry.characterEpoch += 1
      local characterEpoch = entry.characterEpoch
      data._character, data._releasedCharacter = character, nil
      local version = invalidatePlayerWork(data)
      -- Character death ownership survives replay invalidation while readiness is pending.
      local function bindDeath(humanoid)
        if not humanoid or not current(player, entry) or entry.character ~= character or entry.characterEpoch ~= characterEpoch
          or player.Character ~= character then return end
        local function died()
          if not current(player, entry) or entry.character ~= character or entry.characterEpoch ~= characterEpoch then return end
          entry.dead = true
          disconnectDeath(entry)
          releaseParticipation(player, entry)
        end
        data._deathConnection = humanoid.Died:Connect(died)
        if humanoid.Health <= 0 then died() end
      end
      local humanoid = character:FindFirstChildOfClass("Humanoid")
      if humanoid then bindDeath(humanoid)
      else task.spawn(function() bindDeath(character:WaitForChild("Humanoid", 10)) end) end
      scheduleRestore(player, entry, character, version)
    end
    data._characterConnection = player.CharacterAdded:Connect(characterAdded)
    data._removingConnection = player.CharacterRemoving:Connect(function(character)
      if not current(player, entry) or entry.character ~= character then return end
      disconnectDeath(entry)
      releaseParticipation(player, entry)
      entry.character, data._character = nil, nil
    end)
    if player.Character then characterAdded(player.Character) end
  end
  function controller.reset(player, resetState)
    local entry = records[player]
    if not entry or not current(player, entry) or entry.resetting then return false end
    entry.resetting = true
    local humanoid = entry.character and entry.character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then entry.dead = true end
    local version = releaseParticipation(player, entry)
    if not current(player, entry) then entry.resetting = false; return false end
    local ok, message = true, nil
    if resetState then ok, message = pcall(resetState, player, entry.data) end
    entry.resetting = false
    if not ok then error(message, 0) end
    -- A replacement/leave/death during a callback owns its own restoration, if any.
    if current(player, entry) and entry.data._workVersion == version then
      local character = entry.character
      local humanoid = character and character:FindFirstChildOfClass("Humanoid")
      if character and not entry.dead and player.Character == character and (not humanoid or humanoid.Health > 0) then
        entry.released, entry.data._releasedCharacter = false, nil
        scheduleRestore(player, entry, character, version)
      end
    end
    return true
  end
  function controller.destroy()
    if destroyed then return end
    destroyed = true
    for _, connection in ipairs(connections) do connection:Disconnect() end
    table.clear(connections)
    for player, entry in pairs(records) do remove(player, entry) end
  end
  table.insert(connections, players.PlayerAdded:Connect(added))
  table.insert(connections, players.PlayerRemoving:Connect(function(player)
    local entry = records[player]
    if entry then remove(player, entry) end
  end))
  for _, player in ipairs(players:GetPlayers()) do added(player) end
  return table.freeze(controller)
end

local function createInteraction(states, target, properties, onTriggered)
  assert(game:GetService("RunService"):IsServer(), "createInteraction is server-only")
  assert(typeof(target) == "Instance" and (target:IsA("BasePart") or target:IsA("Attachment")),
    "Interaction target must be a BasePart or Attachment")
  local world = game:GetService("Workspace")
  local prompt = Instance.new("ProximityPrompt")
  for property, value in pairs(properties or {}) do
    assert(property ~= "Parent", "The helper owns the prompt's parent")
    prompt[property] = value
  end
  local connections, destroyed = {}, false
  local controller = {prompt = prompt}
  function controller.destroy()
    if destroyed then return end
    destroyed = true
    for _, connection in ipairs(connections) do connection:Disconnect() end
    table.clear(connections)
    prompt:Destroy()
  end
  table.insert(connections, prompt.Triggered:Connect(function(player)
    if destroyed or not prompt.Enabled or prompt.Parent ~= target or not target:IsDescendantOf(world) then return end
    local data, character, humanoid, root = getLivePlayer(states, player)
    if not data or not character:IsDescendantOf(world) then return end
    local position = target:IsA("Attachment") and target.WorldPosition or target.Position
    if not ((root.Position - position).Magnitude <= prompt.MaxActivationDistance) then return end
    onTriggered(player, {state = data, character = character, humanoid = humanoid, root = root})
  end))
  table.insert(connections, target.Destroying:Connect(controller.destroy))
  table.insert(connections, prompt.Destroying:Connect(controller.destroy))
  prompt.Parent = target
  return table.freeze(controller)
end
api.helpers = table.freeze({
  version = "build-fast-helpers/v9",
  getLivePlayer = function(states, player)
    local state, character, humanoid, root = getLivePlayer(states, player)
    if not state then return nil end
    return {state = state, character = character, humanoid = humanoid, root = root}
  end,
  invalidatePlayerWork = invalidatePlayerWork,
  restoreCurrentCharacter = restoreCurrentCharacter,
  bindPlayerLifecycle = bindPlayerLifecycle,
  createInteraction = createInteraction,
  addPlayerCleanup = addPlayerCleanup,
  clearPlayerCleanup = clearPlayerCleanup,
  bindInputActions = bindInputActions,
  bindHeldInput = bindHeldInput,
  applyHeldInput = applyHeldInput,
  attachControlFrame = attachControlFrame,
  createGroundMover = createGroundMover,
  placeActor = placeActor,
  createFeedbackPulse = createFeedbackPulse,
  replacePlayerTool = replacePlayerTool,
  observeHealth = observeHealth,
  placePlayer = placePlayer,
  holdPlayer = holdPlayer,
})
end
local assetInterfaces = game:GetService("HttpService"):JSONDecode([=[{}]=])
do
 local RunService = game:GetService("RunService")
 local handles = setmetatable({}, {__mode = "kv"})
 local byPath = setmetatable({}, {__mode = "v"})
 local assets = {}
 local function alive(model) return model and model:IsDescendantOf(workspace) end
 local function member(model, path)
  local current = model
  for name in string.gmatch(path, "[^/]+") do
   current = current:FindFirstChild(name)
   if not current then return nil end
  end
  return current
 end
 local function description(model)
  return assetInterfaces[model:GetAttribute("AssetLibraryId") .. "@" .. model:GetAttribute("AssetLibraryVersion")] or {}
 end
 function assets.get(target, timeout)
  local deadline = os.clock() + math.max(0, timeout or 0)
  local model
  repeat
   if typeof(target) == "Instance" then model = target
   elseif type(target) == "string" then
    model = byPath[target]
    if not alive(model) then
     model = nil
     for _, object in ipairs(workspace:GetDescendants()) do
      if object:IsA("Model") and object:GetAttribute("SceneProgramAssembly") == target and object:GetAttribute("AssetLibraryId") then
       model = object
      end
      if object:IsA("Model") and object:GetAttribute("AssetLibraryId") and object:GetAttribute("SceneProgramAssembly") then
       byPath[object:GetAttribute("SceneProgramAssembly")] = object
      end
     end
    end
   end
   if alive(model) then break end
   if os.clock() >= deadline then return nil end
   task.wait(0.1)
  until false
  if not model:IsA("Model") or not model:GetAttribute("AssetLibraryId") or not model:GetAttribute("AssetLibraryVersion") then return nil end
  if handles[model] then return handles[model] end
  local spec = description(model)
  local handle = {model = model}
  function handle:ready(timeoutSeconds)
   local untilTime = os.clock() + math.max(0, timeoutSeconds or 0)
   repeat
    if not alive(model) then return false end
    if not spec.readiness then return true end
    local state = member(model, spec.readiness)
    if state and state:IsA("BoolValue") and state.Value then return true end
    if os.clock() >= untilTime then return false end
    task.wait()
   until false
  end
  function handle:reference(name)
   if not alive(model) then return nil end
   local path = (spec.references or {})[name]
   local object = path and member(model, path)
   if object and object:IsA("ObjectValue") then return object.Value end
   return object
  end
  function handle:has(name) return (spec.operations or {})[name] ~= nil end
  function handle:call(name, ...)
   local operation = (spec.operations or {})[name]
   assert(operation, "Asset does not expose operation: " .. tostring(name))
   assert(alive(model), "Asset has been removed")
   assert(operation.side == "both" or (operation.side == "server" and RunService:IsServer()) or (operation.side == "client" and RunService:IsClient()), "Asset operation called from the wrong side: " .. name)
   local endpoint = member(model, operation.member)
   local className = operation.kind == "event" and "BindableEvent" or "BindableFunction"
   assert(endpoint and endpoint:IsA(className), "Asset operation is unavailable: " .. name)
   if operation.kind == "event" then endpoint:Fire(...); return end
   return endpoint:Invoke(...)
  end
  handles[model] = handle
  return handle
 end
 api.assets = assets
end
return api]]></ProtectedString>
